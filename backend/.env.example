# Copy this file to .env and fill in the values before starting the app.
# The app will refuse to start if the required variables below are missing.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Required — SQLite file path (Prisma connection string)
DATABASE_URL="file:./dev.db"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-at-least-32-chars-replace-with-real-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS / Cookies ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
COOKIE_DOMAIN=localhost
